# Copy to .env.lan, choose a trusted LAN interface, and keep the host firewall enabled.
COMPOSE_PROJECT_NAME=hsbc-housing
IMAGE_TAG=dev
PUBLISH_HOST=0.0.0.0
WEB_PORT=3000
MODEL_PORT=8000
ESTIMATOR_DEBUG_PORT=8001

POSTGRES_DB=housing
POSTGRES_ADMIN_USER=housing_admin
POSTGRES_ADMIN_PASSWORD=change-local-admin-password
TRAINING_DB_PASSWORD=change-training-password
MODEL_DB_PASSWORD=change-model-password
ESTIMATOR_DB_PASSWORD=change-estimator-password
MARKET_DB_PASSWORD=change-market-password
MARKET_CURSOR_HMAC_SECRET=change-this-to-at-least-32-random-characters

# Replace 192.168.1.50 with this machine's LAN address.
PORTAL_PUBLIC_ORIGIN=http://192.168.1.50:3000
GIT_COMMIT_SHA=0000000
