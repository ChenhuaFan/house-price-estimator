{
  "name": "housing-intelligence-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:live && pnpm test:e2e:mock",
    "test:e2e:live": "playwright test tests/e2e/model-api.spec.ts --project=chromium",
    "test:e2e:mock": "E2E_MOCKS=1 playwright test --project=chromium",
    "generate:market-contract": "openapi-typescript ../docs/openapi/market-service-v2.yaml -o lib/api/market-v2.generated.ts",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.59.0",
    "motion": "^12.23.24",
    "next": "15.5.28",
    "react": "19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.0.15",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.14",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "9.22.0",
    "eslint-config-next": "15.5.28",
    "openapi-typescript": "^7.10.1",
    "jsdom": "26.0.0",
    "tailwindcss": "4.0.15",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  }
}
